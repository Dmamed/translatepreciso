{
  "manifest_version": 3,
  "name": "Traductor Preciso",
  "version": "1.0.0",
  "description": "Traducción natural y precisa con IA, pensada para textos de filosofía y teología.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Ajustes del Traductor Preciso" },
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Traducir el texto seleccionado"
    }
  }
}
